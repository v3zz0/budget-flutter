<?xml version="1.0" encoding="utf-8"?>
<!--
  Barra del budget consumato. Il colore della parte piena lo decide il codice
  (accento o rosso se il budget è sforato) via setProgressTintList: qui c'è
  solo la forma.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_accent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
